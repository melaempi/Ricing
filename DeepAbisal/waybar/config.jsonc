// ~/.config/waybar/config.jsonc
{
  "layer": "top",
  "position": "bottom",
  "height": 46,
  "margin-bottom": 8,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 4,
  "reload_style_on_change": true,

  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["custom/start", "wlr/taskbar"],
  "modules-right": ["tray", "bluetooth", "network", "pulseaudio", "clock", "custom/power"],

  "custom/start": {
    "format": "\uf17c",
    "tooltip": false,
    "on-click": "pkill -x fuzzel || fuzzel"
  },

  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate"
  },

  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 22,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close"
  },

  "tray": {
    "icon-size": 18,
    "spacing": 8
  },

  "bluetooth": {
    "format": "\uf293",
    "format-connected": "\uf293 {device_alias}",
    "format-disabled": ""
  },

  "network": {
    "format-wifi": "\uf1eb  {essid}",
    "format-ethernet": "\uf0ac",
    "format-disconnected": "\uf071",
    "tooltip": false
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "\uf026",
    "format-icons": { "default": ["\uf027", "\uf028"] },
    "on-click": "pavucontrol"
  },

  "clock": {
    "interval": 30,
    "format": "{:%I:%M}",
    "tooltip": false,
    "on-click": "pkill -x yad || yad --calendar --undecorated --close-on-unfocus --no-buttons --skip-taskbar --width=420 --height=380"
  },

  "custom/power": {
    "format": "\uf011",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "/home/jordi/.config/waybar/power_menu.xml",
    "menu-actions": {
      "shutdown": "loginctl poweroff",
      "reboot": "loginctl reboot"
    }
  }
}
